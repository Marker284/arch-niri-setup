{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "type": "custom",
            "format": "┌──────────────────────────"
        },
        {
            "type": "os",
            "key": "󰌽  OS   ",
            "keyColor": "cyan"
        },
        {
            "type": "kernel",
            "key": "󰒓  Kernel",
            "keyColor": "cyan"
        },
        {
            "type": "shell",
            "key": "󰆍  Shell ",
            "keyColor": "cyan"
        },
        {
            "type": "packages",
            "key": "󰏖  Pkgs  ",
            "keyColor": "cyan"
        },
        {
            "type": "uptime",
            "key": "󰅐  Uptime",
            "keyColor": "cyan"
        },
        {
            "type": "command",
            "key": "󰃭  Age   ",
            "keyColor": "cyan",
            "outputColor": "cyan",
            "shell": "/bin/sh",
            "text": "~/.config/fastfetch/scripts/system-age.sh"
        },
        {
            "type": "custom",
            "format": "├──────────────────────────"
        },
        {
            "type": "cpu",
            "key": "󰻠  CPU   ",
            "keyColor": "yellow"
        },
        {
            "type": "memory",
            "key": "󰍛  RAM   ",
            "keyColor": "yellow"
        },
        {
            "type": "disk",
            "key": "󰋊  Disk  ",
            "keyColor": "yellow"
        },
        {
            "type": "custom",
            "format": "├──────────────────────────"
        },
        {
            "type": "localip",
            "key": "󰩟  LAN IP",
            "keyColor": "green",
            "compact": true
        },
        {
            "type": "command",
            "key": "󰤨  WiFi  ",
            "keyColor": "green",
            "outputColor": "green",
            "shell": "/bin/sh",
            "text": "~/.config/fastfetch/scripts/wifi-info.sh"
        },
        {
            "type": "custom",
            "format": "├──────────────────────────"
        },
        {
            "type": "command",
            "key": "󰁹  Batt  ",
            "keyColor": "magenta",
            "outputColor": "magenta",
            "shell": "/bin/sh",
            "text": "~/.config/fastfetch/scripts/battery-detail.sh",
            "splitLines": true
        },
        {
            "type": "custom",
            "format": "└──────────────────────────"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
